# 复制为 .env 并按需修改（服务启动时自动加载；缺失时从本文件复制）
# ===== 服务 =====
PORT=51889
# 对外访问地址（回调/登出重定向/配置 JSON 用）；留空 = 跟随请求 Host
PUBLIC_BASE_URL=

# ===== Keycloak（SSO 登录）=====
# 对接本机/内网 Keycloak 实例（与 aimemory 等应用共用 SSO 时保持同一 host）
KEYCLOAK_URL=http://localhost:18443
KEYCLOAK_REALM=bip-timesheet
KEYCLOAK_CLIENT_ID=bip-timesheet-web

# ===== Keycloak 初始化（scripts/setup-keycloak.mjs 使用，master realm 管理凭据）=====
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# 测试用户（逗号分隔）；留空 = 复用现有用户，不创建
TEST_USERS=alice,bob,charlie
TEST_USERS_PASSWORD=bip-test-2026

# ===== 会话 =====
# 首次启动自动生成并写回本文件（用于 BIP 凭据加密与 cookie 一致性）
SESSION_SECRET=

# ===== Python 核心（BIP 交互，可选）=====
# Python 解释器（默认自动探测：python/.venv 内 → PATH 上的 python）
# PYTHON_BIN=C:\Users\kui.song\.local\bin\python3.11.exe
# 并发：同时运行的 python 进程上限（per-账号串行固定，此为全局并发池大小）
# MAX_CONCURRENT_CLI=20
# 单次 CLI 调用超时（毫秒）
# CLI_TIMEOUT_MS=300000
